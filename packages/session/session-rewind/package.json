{
  "name": "@x1a0f3n9/dsh-rewind",
  "description": "Workspace and conversation rewind plugin with durable file checkpoints",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LunFengChen/deepseek-harness.git",
    "directory": "packages/session/session-rewind"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@x1a0f3n9/dsh-client-locale",
        "@x1a0f3n9/dsh-client-ui-chat",
        "@x1a0f3n9/dsh-client-ui-commands",
        "@x1a0f3n9/dsh-client-ui-conversation",
        "@x1a0f3n9/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^",
    "@x1a0f3n9/dsh-home-paths": "workspace:^",
    "@x1a0f3n9/dsh-llm": "workspace:^",
    "@x1a0f3n9/dsh-sandbox": "workspace:^",
    "@x1a0f3n9/dsh-session": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@x1a0f3n9/dsh-agent": "workspace:^",
    "@x1a0f3n9/dsh-api-session-controller": "workspace:^",
    "@x1a0f3n9/dsh-client-connection": "workspace:^",
    "@x1a0f3n9/dsh-client-locale": "workspace:^",
    "@x1a0f3n9/dsh-client-test-runtime": "workspace:^",
    "@x1a0f3n9/dsh-client-ui-chat": "workspace:^",
    "@x1a0f3n9/dsh-client-ui-commands": "workspace:^",
    "@x1a0f3n9/dsh-client-ui-conversation": "workspace:^",
    "@x1a0f3n9/dsh-client-ui-input-trigger": "workspace:^",
    "@x1a0f3n9/dsh-client-ui-renderer": "workspace:^",
    "@x1a0f3n9/dsh-client-ui-session": "workspace:^",
    "@x1a0f3n9/dsh-client-ui-settings": "workspace:^",
    "@x1a0f3n9/dsh-client-ui-slots": "workspace:^",
    "@x1a0f3n9/dsh-commands": "workspace:^",
    "@x1a0f3n9/dsh-fs": "workspace:^",
    "@x1a0f3n9/dsh-settings": "workspace:^",
    "@x1a0f3n9/dsh-tools": "workspace:^",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "SECURITY.md",
    "LICENSE"
  ]
}
