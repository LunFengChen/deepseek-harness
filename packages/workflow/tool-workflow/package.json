{
  "name": "@x1a0f3n9/dsh-tool-workflow",
  "description": "Model-facing workflow tool: run a JavaScript orchestration script over ctx.workflowEngine",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/workflow/tool-workflow"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@x1a0f3n9/dsh-agent": "workspace:*",
    "@x1a0f3n9/dsh-jobs": "workspace:*",
    "@x1a0f3n9/dsh-llm": "workspace:*",
    "@x1a0f3n9/dsh-session": "workspace:*",
    "@x1a0f3n9/dsh-system-prompt": "workspace:*",
    "@x1a0f3n9/dsh-tools": "workspace:*",
    "@x1a0f3n9/dsh-workflow": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@x1a0f3n9/dsh-agent": "workspace:*",
    "@x1a0f3n9/dsh-agent-loop-testkit": "workspace:*",
    "@x1a0f3n9/dsh-jobs": "workspace:*",
    "@x1a0f3n9/dsh-jobs-local": "workspace:*",
    "@x1a0f3n9/dsh-llm": "workspace:*",
    "@x1a0f3n9/dsh-session": "workspace:*",
    "@x1a0f3n9/dsh-session-projection": "workspace:*",
    "@x1a0f3n9/dsh-subagent": "workspace:*",
    "@x1a0f3n9/dsh-system-prompt": "workspace:*",
    "@x1a0f3n9/dsh-tool-jobs": "workspace:*",
    "@x1a0f3n9/dsh-tools": "workspace:*",
    "@x1a0f3n9/dsh-workflow": "workspace:*",
    "@x1a0f3n9/dsh-workflow-ptc": "workspace:*"
  }
}
