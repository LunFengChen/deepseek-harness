{
  "name": "@xfcodeai/dsh-tool-web",
  "description": "Model-facing web tools (web_search, web_fetch) over the DeepSeek Harness web capability seam (ctx.web)",
  "version": "0.1.2-alpha.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/web/tool-web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@xfcodeai/dsh-llm": "workspace:^",
    "@xfcodeai/dsh-system-prompt": "workspace:^",
    "@xfcodeai/dsh-tools": "workspace:^",
    "@xfcodeai/dsh-web": "workspace:^"
  },
  "dependencies": {
    "@xfcodeai/dsh-util-values": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@xfcodeai/dsh-agent": "workspace:^",
    "@xfcodeai/dsh-llm": "workspace:^",
    "@xfcodeai/dsh-session": "workspace:^",
    "@xfcodeai/dsh-spill-local": "workspace:^",
    "@xfcodeai/dsh-spill-policy": "workspace:^",
    "@xfcodeai/dsh-system-prompt": "workspace:^",
    "@xfcodeai/dsh-tool-call-timeout-policy": "workspace:^",
    "@xfcodeai/dsh-tools": "workspace:^",
    "@xfcodeai/dsh-web": "workspace:^",
    "@xfcodeai/dsh-web-fetch-http": "workspace:^",
    "@xfcodeai/dsh-web-search-exa": "workspace:^",
    "@types/turndown": "^5.0.6"
  }
