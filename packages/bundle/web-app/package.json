{
  "name": "@x1a0f3n9/dsh-web-app",
  "description": "The dsh browser-surface bundle: the web patch layer over dsh-base plus the runtime glue plugin (frontend dist serving, web-surface prompt, bash runtime variables, URL line)",
  "version": "0.1.5-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/web-app"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/startup.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "plugins": [
        {
          "id": "session-timeline",
          "entryId": "dsh-session-timeline",
          "packageName": "@x1a0f3n9/dsh-session-timeline",
          "title": "Session timeline",
          "description": "Rewind, delete, and regenerate conversation turns.",
          "defaultEnabled": true,
          "author": "LunFengChen",
          "homepage": "https://github.com/LunFengChen/deepseek-harness"
        },
        {
          "id": "plugin-market",
          "entryId": "dsh-market",
          "packageName": "dshmarket",
          "title": "Plugin market",
          "description": "Browse and install community dsh plugins.",
          "defaultEnabled": true,
          "author": "LunFengChen",
          "homepage": "https://github.com/LunFengChen/dsh-market"
        },
        {
          "id": "reasoning-effort",
          "entryId": "reasoning-effort",
          "packageName": "dsh-reasoning-effort",
          "title": "Reasoning effort",
          "description": "Pick thinking strength in the composer.",
          "defaultEnabled": true,
          "author": "LunFengChen",
          "homepage": "https://github.com/LunFengChen/dsh-reasoning-effort"
        },
        {
          "id": "dsh-context",
          "entryId": "dsh-context",
          "packageName": "dsh-context",
          "title": "Context dashboard",
          "description": "Inspect context composition, compaction, and token use.",
          "defaultEnabled": true,
          "author": "LunFengChen",
          "homepage": "https://github.com/LunFengChen/dsh-context"
        },
        {
          "id": "better-sidebar",
          "entryId": "better-sidebar",
          "packageName": "dsh-better-sidebar",
          "title": "Better sidebar",
          "description": "File, terminal, Git, and subagent workbench in the sidebar.",
          "defaultEnabled": true,
          "author": "LunFengChen",
          "homepage": "https://github.com/LunFengChen/DSH-better-sidebar"
        },
        {
          "id": "hindsight",
          "entryId": "hindsight",
          "packageName": "@vectorize-io/hindsight-coding-agents",
          "title": "Hindsight memory",
          "description": "Long-term project memory. Defaults to a local Hindsight daemon; cloud is optional.",
          "defaultEnabled": true,
          "author": "vectorize-io",
          "homepage": "https://github.com/vectorize-io/hindsight/tree/main/hindsight-integrations/coding-agents"
        }
      ]
    }
  },
  "dependencies": {
    "@x1a0f3n9/dsh-agent-presets": "workspace:^",
    "@x1a0f3n9/dsh-api-remotes": "workspace:^",
    "@x1a0f3n9/dsh-api-session-controller": "workspace:^",
    "@x1a0f3n9/dsh-api-settings-controller": "workspace:^",
    "@x1a0f3n9/dsh-api-workspace-controller": "workspace:^",
    "@x1a0f3n9/dsh-api-workspace-files": "workspace:^",
    "@x1a0f3n9/dsh-app-boot": "workspace:^",
    "@x1a0f3n9/dsh-client-connection": "workspace:^",
    "@x1a0f3n9/dsh-client-file-upload": "workspace:^",
