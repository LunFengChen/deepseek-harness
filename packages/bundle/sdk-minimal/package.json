{
  "name": "@xfcodeai/dsh-sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, one DeepSeek adapter, persistent shell, editor, and JSONL sessions",
  "version": "0.1.2-alpha.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/sdk-minimal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-timer": "workspace:^",
    "@xfcodeai/dsh-agent": "workspace:^",
    "@xfcodeai/dsh-agent-loop": "workspace:^",
    "@xfcodeai/dsh-deepseek-llm-api-extensions": "workspace:^",
    "@xfcodeai/dsh-fs-local": "workspace:^",
    "@xfcodeai/dsh-invariants": "workspace:^",
    "@xfcodeai/dsh-jobs-local": "workspace:^",
    "@xfcodeai/dsh-llm": "workspace:^",
    "@xfcodeai/dsh-llm-deepseek": "workspace:^",
    "@xfcodeai/dsh-llm-retry": "workspace:^",
    "@xfcodeai/dsh-plugin-package-inventory-deepseek": "workspace:^",
    "@xfcodeai/dsh-sandbox-local": "workspace:^",
    "@xfcodeai/dsh-sandbox-policy": "workspace:^",
    "@xfcodeai/dsh-scope": "workspace:^",
    "@xfcodeai/dsh-sdk-app": "workspace:^",
    "@xfcodeai/dsh-sdk-jsonrpc-server": "workspace:^",
    "@xfcodeai/dsh-session": "workspace:^",
    "@xfcodeai/dsh-session-log-deepseek": "workspace:^",
    "@xfcodeai/dsh-session-persistence-jsonl": "workspace:^",
    "@xfcodeai/dsh-session-projection": "workspace:^",
    "@xfcodeai/dsh-session-title": "workspace:^",
    "@xfcodeai/dsh-subprocess-local": "workspace:^",
    "@xfcodeai/dsh-system-prompt": "workspace:^",
    "@xfcodeai/dsh-terminal": "workspace:^",
    "@xfcodeai/dsh-terminal-bash": "workspace:^",
    "@xfcodeai/dsh-tool-bash-persistent": "workspace:^",
    "@xfcodeai/dsh-tool-pwsh-persistent": "workspace:^",
    "@xfcodeai/dsh-tool-str-replace-editor": "workspace:^",
    "@xfcodeai/dsh-tools": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  }
}
