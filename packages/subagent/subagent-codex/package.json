{
  "name": "@x1a0f3n9/dsh-subagent-codex",
  "description": "One-shot Codex subagent provider over the official app-server protocol",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/subagent/subagent-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@x1a0f3n9/dsh-llm": "workspace:*",
    "@x1a0f3n9/dsh-session": "workspace:*",
    "@x1a0f3n9/dsh-subagent": "workspace:*",
    "@x1a0f3n9/dsh-subprocess": "workspace:*",
    "@x1a0f3n9/dsh-timeout": "workspace:*"
  },
  "dependencies": {
    "@x1a0f3n9/dsh-brand": "workspace:*",
    "@x1a0f3n9/dsh-sdk-protocol": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@openai/codex": "0.153.4",
    "@x1a0f3n9/dsh-tool-subagent": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@x1a0f3n9/dsh-agent": "workspace:*",
    "@x1a0f3n9/dsh-app-boot": "workspace:*",
    "@x1a0f3n9/dsh-llm": "workspace:*",
    "@x1a0f3n9/dsh-loader-smoke": "workspace:*",
    "@x1a0f3n9/dsh-session": "workspace:*",
    "@x1a0f3n9/dsh-session-checkpoint-policy": "workspace:*",
    "@x1a0f3n9/dsh-session-persistence-jsonl": "workspace:*",
    "@x1a0f3n9/dsh-session-projection": "workspace:*",
    "@x1a0f3n9/dsh-subagent": "workspace:*",
    "@x1a0f3n9/dsh-subprocess": "workspace:*",
    "@x1a0f3n9/dsh-subprocess-local": "workspace:*",
    "@x1a0f3n9/dsh-timeout": "workspace:*",
    "@x1a0f3n9/dsh-tool-jobs": "workspace:*",
    "@x1a0f3n9/dsh-tools": "workspace:*"
  },
  "icon": "./icon.svg"
}
