    "@x1a0f3n9/dsh-tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@x1a0f3n9/dsh-agent": "workspace:^",
    "@x1a0f3n9/dsh-shell": "workspace:^",
    "@x1a0f3n9/dsh-llm": "workspace:^",
    "@x1a0f3n9/dsh-home-paths": "workspace:^",
    "@x1a0f3n9/dsh-session-persistence": "workspace:^",
    "@x1a0f3n9/dsh-tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
