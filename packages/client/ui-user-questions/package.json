{
  "name": "@x1a0f3n9/dsh-client-ui-user-questions",
  "description": "Web ask_user_question composer takeover and plan-review presentation UI",
  "version": "0.1.2-alpha.6",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-user-questions"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@x1a0f3n9/dsh-api-remotes",
        "@x1a0f3n9/dsh-api-session-controller",
        "@x1a0f3n9/dsh-client-locale",
        "@x1a0f3n9/dsh-client-ui-conversation",
        "@x1a0f3n9/dsh-client-ui-renderer",
        "@x1a0f3n9/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@x1a0f3n9/dsh-agent": "workspace:^",
    "@x1a0f3n9/dsh-api-remotes": "workspace:^",
    "@x1a0f3n9/dsh-api-session-controller": "workspace:^",
    "@x1a0f3n9/dsh-client-locale": "workspace:^",
    "@x1a0f3n9/dsh-client-store": "workspace:^",
    "@x1a0f3n9/dsh-system-prompt": "workspace:^",
    "@x1a0f3n9/dsh-tools": "workspace:^",
    "@x1a0f3n9/dsh-user-questions": "workspace:^",
    "@types/react": "~18.3.1",
    "@x1a0f3n9/dsh-client-ui-primitives": "workspace:^",
    "@x1a0f3n9/dsh-client-ui-slots": "workspace:^",
    "@x1a0f3n9/dsh-client-ui-renderer": "workspace:^",
    "@x1a0f3n9/dsh-client-ui-session": "workspace:^",
    "@x1a0f3n9/dsh-typert-protocol": "workspace:^",
    "react": "^18.2.0",
    "@x1a0f3n9/dsh-client-ui-conversation": "workspace:^",
    "@x1a0f3n9/dsh-client-connection": "workspace:^",
    "@x1a0f3n9/dsh-session": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
