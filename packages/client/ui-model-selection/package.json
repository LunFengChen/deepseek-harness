{
  "name": "@xfcodeai/dsh-client-ui-model-selection",
  "description": "Model selection over the shared model catalog, Session projection, and session.selectModel",
  "version": "0.1.2-alpha.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-model-selection"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@xfcodeai/dsh-api-session-controller",
        "@xfcodeai/dsh-client-locale",
        "@xfcodeai/dsh-client-ui-commands",
        "@xfcodeai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@xfcodeai/dsh-api-remotes": "workspace:^",
    "@xfcodeai/dsh-api-session-controller": "workspace:^",
    "@xfcodeai/dsh-client-locale": "workspace:^",
    "@xfcodeai/dsh-client-test-runtime": "workspace:^",
    "@xfcodeai/dsh-client-ui-commands": "workspace:^",
    "@xfcodeai/dsh-client-ui-conversation": "workspace:^",
    "@xfcodeai/dsh-client-ui-input-trigger": "workspace:^",
    "@xfcodeai/dsh-client-ui-primitives": "workspace:^",
    "@xfcodeai/dsh-client-ui-slots": "workspace:^",
    "@xfcodeai/dsh-typert-protocol": "workspace:^",
    "@types/react": "~18.3.1",
    "@deepseek-ai/cordis": "workspace:^",
    "react": "^18.2.0",
    "@xfcodeai/dsh-client-store": "workspace:^",
    "@xfcodeai/dsh-session": "workspace:^",
    "@xfcodeai/dsh-client-ui-renderer": "workspace:^",
    "@xfcodeai/dsh-client-ui-session": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "clsx": "^2.1.1"
  }
}
