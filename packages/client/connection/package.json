{
  "name": "@x1a0f3n9/dsh-client-connection",
  "description": "Authenticated RPC transport and generation lifecycle",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/connection"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "node": "./lib/client.node.js",
      "browser": "./lib/client.browser.js",
      "default": "./lib/client.browser.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "@x1a0f3n9/dsh-credentials": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.browser.js",
    "lib/client.node.js",
    "lib/types/**/*.d.ts"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@x1a0f3n9/dsh-scope": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@x1a0f3n9/dsh-attachment": "workspace:*",
    "@x1a0f3n9/dsh-brand": "workspace:*",
    "@x1a0f3n9/dsh-host-webserver": "workspace:*",
    "@x1a0f3n9/dsh-llm": "workspace:*",
    "@x1a0f3n9/dsh-scope": "workspace:*",
    "@x1a0f3n9/dsh-session": "workspace:*",
    "@x1a0f3n9/dsh-typert-protocol": "workspace:*"
  }
}
