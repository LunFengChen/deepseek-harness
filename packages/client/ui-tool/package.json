{
  "name": "@x1a0f3n9/dsh-client-ui-tool",
  "description": "Client Tool call-tree renderer and keyed per-tool presentation slot",
  "version": "0.1.2-alpha.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-tool"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@x1a0f3n9/dsh-api-workspace-controller",
        "@x1a0f3n9/dsh-client-connection",
        "@x1a0f3n9/dsh-client-locale",
        "@x1a0f3n9/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@x1a0f3n9/dsh-api-remotes": "workspace:^",
    "@x1a0f3n9/dsh-client-connection": "workspace:^",
    "@x1a0f3n9/dsh-client-locale": "workspace:^",
    "@x1a0f3n9/dsh-client-test-runtime": "workspace:^",
    "@x1a0f3n9/dsh-client-ui-conversation": "workspace:^",
    "@x1a0f3n9/dsh-client-ui-primitives": "workspace:^",
    "@x1a0f3n9/dsh-client-ui-slots": "workspace:^",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@x1a0f3n9/dsh-api-workspace-controller": "workspace:^",
    "@x1a0f3n9/dsh-client-ui-chat": "workspace:^",
    "@x1a0f3n9/dsh-client-ui-renderer": "workspace:^",
    "@x1a0f3n9/dsh-client-ui-session": "workspace:^",
    "@x1a0f3n9/dsh-util-workspace-path": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
