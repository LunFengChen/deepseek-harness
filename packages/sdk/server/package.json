{
  "name": "@xfcodeai/dsh-sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process DeepSeek Harness SDK clients",
  "version": "0.1.2-alpha.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@xfcodeai/dsh-brand": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@xfcodeai/dsh-agent": "workspace:^",
    "@xfcodeai/dsh-attachment": "workspace:^",
    "@xfcodeai/dsh-llm": "workspace:^",
    "@xfcodeai/dsh-llm-deepseek": "workspace:^",
    "@xfcodeai/dsh-scope": "workspace:^",
    "@xfcodeai/dsh-sdk-protocol": "workspace:^",
    "@xfcodeai/dsh-session": "workspace:^",
    "@xfcodeai/dsh-subagent": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@xfcodeai/dsh-agent": "workspace:^",
    "@xfcodeai/dsh-agent-loop": "workspace:^",
    "@xfcodeai/dsh-agent-loop-testkit": "workspace:^",
    "@xfcodeai/dsh-attachment": "workspace:^",
    "@xfcodeai/dsh-llm": "workspace:^",
    "@xfcodeai/dsh-llm-deepseek": "workspace:^",
    "@xfcodeai/dsh-scope": "workspace:^",
    "@xfcodeai/dsh-sdk-protocol": "workspace:^",
    "@xfcodeai/dsh-session": "workspace:^",
    "@xfcodeai/dsh-session-persistence-jsonl": "workspace:^",
    "@xfcodeai/dsh-session-projection": "workspace:^",
    "@xfcodeai/dsh-subagent": "workspace:^"
  }
}
