{
  "name": "@x1a0f3n9/dsh-api-remotes",
  "description": "Remote BFF assembly for application-selected Host capabilities",
  "version": "0.1.2-alpha.6",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@x1a0f3n9/dsh-api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@x1a0f3n9/dsh-deque": "workspace:^",
    "@x1a0f3n9/dsh-session": "workspace:^",
    "@x1a0f3n9/dsh-util-values": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@x1a0f3n9/dsh-scope": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@x1a0f3n9/dsh-agent-presets": "workspace:^",
    "@x1a0f3n9/dsh-api-gateway": "workspace:^",
    "@x1a0f3n9/dsh-api-settings-controller": "workspace:^",
    "@x1a0f3n9/dsh-api-workspace-controller": "workspace:^",
    "@x1a0f3n9/dsh-commands": "workspace:^",
    "@x1a0f3n9/dsh-cordis-host-runner": "workspace:^",
    "@x1a0f3n9/dsh-credentials": "workspace:^",
    "@x1a0f3n9/dsh-file-reference": "workspace:^",
    "@x1a0f3n9/dsh-goal": "workspace:^",
    "@x1a0f3n9/dsh-host-plugin-inventory": "workspace:^",
    "@x1a0f3n9/dsh-llm": "workspace:^",
    "@x1a0f3n9/dsh-message-feedback": "workspace:^",
    "@x1a0f3n9/dsh-session-reference": "workspace:^",
    "@x1a0f3n9/dsh-settings": "workspace:^",
    "@x1a0f3n9/dsh-subagent": "workspace:^",
    "@x1a0f3n9/dsh-user-approval": "workspace:^",
    "@x1a0f3n9/dsh-user-questions": "workspace:^",
    "@x1a0f3n9/dsh-client-connection": "workspace:^",
    "@x1a0f3n9/dsh-typert-protocol": "workspace:^",
    "@x1a0f3n9/dsh-scope": "workspace:^",
    "@x1a0f3n9/dsh-api-session-controller": "workspace:^"
  }
}
