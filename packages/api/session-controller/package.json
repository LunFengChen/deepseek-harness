{
  "name": "@xfcodeai/dsh-api-session-controller",
  "description": "Session Remote commands, cold reads, and live control transport",
  "version": "0.1.2-alpha.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/api/session-controller"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./remote-events": {
      "types": "./lib/types/remote-events.d.ts",
      "default": "./lib/types/remote-events.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "external": [
        "@xfcodeai/dsh-api-gateway/client"
      ],
      "inject": [
        "@xfcodeai/dsh-api-gateway"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@xfcodeai/dsh-brand": "workspace:^",
    "@xfcodeai/dsh-deque": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@xfcodeai/dsh-agent": "workspace:^",
    "@xfcodeai/dsh-agent-default-model": "workspace:^",
    "@xfcodeai/dsh-agent-presets": "workspace:^",
    "@xfcodeai/dsh-api-gateway": "workspace:^",
    "@xfcodeai/dsh-attachment": "workspace:^",
    "@xfcodeai/dsh-client-connection": "workspace:^",
    "@xfcodeai/dsh-file-reference": "workspace:^",
    "@xfcodeai/dsh-jobs": "workspace:^",
    "@xfcodeai/dsh-llm": "workspace:^",
    "@xfcodeai/dsh-native-command": "workspace:^",
    "@xfcodeai/dsh-scope": "workspace:^",
    "@xfcodeai/dsh-session": "workspace:^",
    "@xfcodeai/dsh-session-persistence": "workspace:^",
    "@xfcodeai/dsh-session-projection": "workspace:^",
    "@xfcodeai/dsh-session-projection-cache": "workspace:^",
    "@xfcodeai/dsh-session-query": "workspace:^",
    "@xfcodeai/dsh-session-title": "workspace:^",
    "@xfcodeai/dsh-skill": "workspace:^",
    "@xfcodeai/dsh-subagent": "workspace:^",
    "@xfcodeai/dsh-typert-protocol": "workspace:^",
    "@xfcodeai/dsh-typert-registry": "workspace:^",
    "@xfcodeai/dsh-util-time": "workspace:^",
    "@xfcodeai/dsh-util-workspace-path": "workspace:^",
    "@xfcodeai/dsh-workspace": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@xfcodeai/dsh-jobs": {
      "optional": true
    },
    "@xfcodeai/dsh-session-persistence": {
      "optional": true
    },
    "@xfcodeai/dsh-session-projection-cache": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@xfcodeai/dsh-agent": "workspace:^",
    "@xfcodeai/dsh-agent-default-model": "workspace:^",
    "@xfcodeai/dsh-agent-presets": "workspace:^",
    "@xfcodeai/dsh-api-gateway": "workspace:^",
    "@xfcodeai/dsh-attachment": "workspace:^",
    "@xfcodeai/dsh-client-connection": "workspace:^",
    "@xfcodeai/dsh-client-store": "workspace:^",
    "@xfcodeai/dsh-file-reference": "workspace:^",
    "@xfcodeai/dsh-jobs": "workspace:^",
    "@xfcodeai/dsh-llm": "workspace:^",
    "@xfcodeai/dsh-native-command": "workspace:^",
    "@xfcodeai/dsh-permission-presets": "workspace:^",
    "@xfcodeai/dsh-scope": "workspace:^",
    "@xfcodeai/dsh-session": "workspace:^",
    "@xfcodeai/dsh-session-persistence": "workspace:^",
    "@xfcodeai/dsh-session-projection": "workspace:^",
    "@xfcodeai/dsh-session-projection-cache": "workspace:^",
    "@xfcodeai/dsh-session-query": "workspace:^",
    "@xfcodeai/dsh-session-title": "workspace:^",
    "@xfcodeai/dsh-skill": "workspace:^",
    "@xfcodeai/dsh-storage": "workspace:^",
    "@xfcodeai/dsh-storage-domain": "workspace:^",
    "@xfcodeai/dsh-storage-json": "workspace:^",
    "@xfcodeai/dsh-subagent": "workspace:^",
    "@xfcodeai/dsh-typert-protocol": "workspace:^",
    "@xfcodeai/dsh-typert-registry": "workspace:^",
    "@xfcodeai/dsh-util-crypto": "workspace:^",
    "@xfcodeai/dsh-util-time": "workspace:^",
    "@xfcodeai/dsh-util-workspace-path": "workspace:^",
    "@xfcodeai/dsh-workspace": "workspace:^"
  }
}
